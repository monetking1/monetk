---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout
	title="About Maria | Astro Theme for UI/UX Designer Portfolios"
	description="About page for the Maria Astro theme, built for UI/UX designer portfolios, product design stories, and case study-driven personal sites."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">About</p>
				<div class="hero-layout">
					<div class="hero-copy">
						<h1 class="display-title">I build the operational infrastructure and systems that make organizations work.</h1>
						<p class="hero-text">
						</p>
					</div>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Background</p>
				</div>
				<div class="story-block">
					<p>
                        Monet King is a Learning Strategist and Process Designer with nearly 18 years of workforce development experience spanning public health, energy, and technology. Her career began at the Association of Public Health Laboratories (APHL) — where she partnered with state, local, and federal health officials and the Centers for Disease Control and Prevention to plan and execute continuing education aimed at building, sustaining, and training the public health laboratory workforce. From there she moved into corporate L&D at FieldCore (GE), Amdocs, and bp — executing and developing programs across power generation, oil and gas, enterprise technology, and global executive leadership. At bp, she served as the operational lead for a 30-session, Houston-based global senior leadership programme and was formally recognized for exceeding performance expectations at the executive level. At Amdocs she drove quality assurance for an enterprise platform spanning 85+ curricula and launched a technical learning program with Google Cloud Platform.
					</p>
					<p>
                    Her independent work spans career exploration, health literacy curriculum, government contracting documentation, and career strategy. She is the founder of <a href="https://brandbymonet.com/" target="_blank">Brand by Monet</a>, a career strategy and writing studio born from her own experience navigating the job search — and the conviction that a precisely written document can make visible what the job market too often obscures. 
					</p>
					<p>
                        Since 2017, King has helped more than 100 professionals position themselves with clarity and intention.
					</p>
					<p>
                        King holds an M.S. in Health Promotion Management from Marymount University and a B.A. in Journalism from Howard University.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Focus Areas</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
                        <li>Onboarding systems design</li>
                        <li>Compliance training infrastructure</li>
                        <li>Facilitation & instructional design</li>
                        <li>LMS administration & SOPs</li>
                        <li>Content Development/Strategy</li>
                    </ul>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 20rem);
		gap: 2.5rem;
		align-items: start;
		margin-top: 1rem;
	}

	.hero-copy {
		max-width: 52rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.hero-text {
		max-width: 44rem;
		margin-top: 1.5rem;
	}

	.hero-portrait-wrap {
		display: flex;
		justify-content: flex-end;
		align-self: start;
		padding-top: 0.35rem;
	}

	.hero-portrait {
		width: min(100%, 20rem);
		height: auto;
		display: block;
		border-radius: 1.5rem;
		box-shadow: 0 18px 40px rgba(23, 23, 23, 0.08);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}


	.outcome-list li {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	@media (max-width: 1100px) {
		.hero-layout {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			align-items: start;
		}

		.hero-copy {
			max-width: 100%;
		}

		.hero-text {
			max-width: 42rem;
		}

		.hero-portrait-wrap {
			justify-content: flex-start;
			padding-top: 0;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.hero-portrait {
			width: min(100%, 16rem);
		}
	}
</style>
