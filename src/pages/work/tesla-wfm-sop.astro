---
import { Image } from 'astro:assets';

import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';

import { siteConfig } from '../../config/site';

import featuredImage from '../../assets/images/tesla-wfm-sop.avif';

const highlights = [
	{ label: 'Client', value: 'Confidential' },
	{ label: 'Completed', value: '2026' },
	{ label: 'Role', value: 'Training Specialist / Contractor Responsible Person' },
];

const outcomes = [
    'Assumed the role of Contractor Responsible Person (CRP) — the designated point-of-contact for customer site access, safety compliance, and worker onboarding in the Workforce Management system.',
    'Identified the right knowledge source independently — locating a project manager in another city when internal resources failed to produce answers.',
    'Learned the full internal WFM process firsthand, then documented it in a 9-section SOP covering new worker assignment, existing worker reassignment, badging, scope extensions, verification, and support contacts.',
    'Trained staff on the system and process ahead of handoff — ensuring the next person designated as CRP can execute independently.',
    'Written to survive turnover — any designated CRP can execute the process from day one without prior institutional knowledge',
];

const caseStudyUrl = new URL('/work/tesla-wfm-sop', siteConfig.siteUrl).toString();

const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: siteConfig.siteUrl,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Work',
				item: new URL('/work', siteConfig.siteUrl).toString(),
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: 'Workforce Management — Worker Assignment SOP',
				item: caseStudyUrl,
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'Workforce Management — Worker Assignment SOP',
		description:
            'The employee responsible for managing worker access at the client site, left the company. No written process existed. The Safety department had no instructions, no contact, and no system knowledge. Site access — including badging, SOW assignment, and customer-required training — was at risk of breaking down entirely.',
		url: caseStudyUrl,
		author: {
			'@type': 'Person',
			name: siteConfig.authorName,
		},
		isPartOf: {
			'@type': 'WebSite',
			name: siteConfig.name,
			url: siteConfig.siteUrl,
		},
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Workforce Management — Worker Assignment SOP"
	description="The employee responsible for managing worker access at the client site, left the company. No written process existed. The Safety department had no instructions, no contact, and no system knowledge. Site access — including badging, SOW assignment, and customer-required training — was at risk of breaking down entirely."
	ogType="article"
	ogImageAlt=""
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Work</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>Confidential</span>
				</p>
				<h1 class="display-title">Workforce Management — Worker Assignment SOP</h1>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image
					class="lead-image"
					src={featuredImage}
					alt=""
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<div class="summary-main">
					<p>
                        The employee responsible for managing worker access at the client site, left the company. No written process existed. The Safety department had no instructions, no contact, and no system knowledge. Site access — including badging, SOW assignment, and customer-required training — was at risk of breaking down entirely.
					</p>
				</div>
			</section>

            <section class="editorial-section" id="outcomes">
				<div class="section-rail">
					<p class="section-kicker">What I Built</p>
				</div>

				<div class="story-block">
					<ul class="outcome-list">
						{outcomes.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>


			<section class="editorial-section" id="skills">
				<div class="section-rail">
					<p class="section-kicker">Skills</p>
				</div>
				<div class="story-block">
					<p class="closing-text">
                        SOP Writing · Process Documentation · Site Compliance · Knowledge Transfer · CRP
					</p>
				</div>
			</section>

		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.hero-note,
	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.supporting-image-section {
		padding: 2rem 0 4rem;
		border-bottom: 1px solid var(--border);
	}

	.supporting-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.summary-side p {
		color: var(--muted-foreground);
	}

	.summary-side strong {
		color: var(--foreground);
	}

	.summary-meta {
		color: var(--muted-foreground);
	}

	.summary-meta strong {
		color: var(--foreground);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#skills {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	.closing-text {
		margin-top: 1.5rem;
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.hero-note,
		.summary-main p,
		.summary-meta,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
