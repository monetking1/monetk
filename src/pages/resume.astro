---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import figmaLogo from '../assets/logos/figma.svg';
import framerLogo from '../assets/logos/framer.svg';
import shopifyLogo from '../assets/logos/shopify.svg';
import webflowLogo from '../assets/logos/webflow.svg';

const tools = [
	{ name: 'Figma', logo: figmaLogo, tone: 'light' },
	{ name: 'Framer', logo: framerLogo, tone: 'dark' },
	{ name: 'Shopify', logo: shopifyLogo, tone: 'light' },
	{ name: 'Webflow', logo: webflowLogo, tone: 'light' },
];
---

<Layout
	title="Resume | Monet King"
	description="Learning design, strategic communication, and the documentation that organizations actually run on."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">Resume</p>
				<h1 class="display-title">I don't separate organizational performance from individual development — the best programs serve both.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
                        Whether you're building a training infrastructure or rewriting your professional story — I work at the intersection of strategy and execution.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Experience</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Training Specialist · February 2026-present</strong><br />
                        Building onboarding infrastructure, SOPs, and training systems from scratch across a multi-site industrial operation.
					</p>
					<p>
						<strong>Training Delivery Consultant bp · 2024–2025</strong><br />
                        Operational Lead for bp's flagship global senior leadership program — owning end-to-end delivery across 30 sessions and executive-level participants spanning Houston and international teams.
					</p>
					<p>
						<strong>Learning Partner Amdocs · 2022–2023</strong><br />
                        Strategic learning advisory across a global technology enterprise. Drove UAT for Amdocs U (85+ curricula, 3,500+ learning items) and launched an inaugural GCP technical learning program for 20 software developers.
					</p>
					<p>
						<strong>Learning Specialist FieldCore (GE) · 2020-2022</strong><br />
                        Successful planning and implementation of training programs.
					</p>
					<p>
						<strong>Training Specialist Association of Public Health Laboratories (APHL) · 2008–2014</strong><br />
                        Training delivery and operational logistics for a national public health organization producing continuing education for laboratory scientists in partnership with the CDC.
					</p>
					<p>
						<strong>Founder & Principal Brand by Monet · 2015–Present</strong><br />
                        Resume writing and career branding consultancy serving hundreds of clients over a decade. Built a repeatable four-step process from intake through delivery.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Education</p>
				</div>
				<div class="story-block">
					<p>
                        <strong>M.S., Health Promotion Management — Marymount University</strong>
					</p>
					<p>
                        <strong>B.A., Journalism — Howard University</strong>
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Writing</p>
				</div>
				<div class="story-block">
					<p>
                        <strong><a href="https://brandbymonet.substack.com" target="_blank">Brand By Monet, The Newsletter</a></strong><br />
                        Brand strategy, business analysis, and cultural commentary. Long-form thinking for readers who want depth over noise.
					</p>
					<p>
                        <strong><a href="https://www.linkedin.com/newsletters/paper-cuts-newsletter-7359268536357212162/" target="_blank">Paper Cuts — LinkedIn Newsletter</a></strong><br />
                        Career advancement, professional branding, and the future of work — written for professionals who live on LinkedIn, not Substack.
					</p>
				</div>
			</section>

		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: 1.75rem;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.tools-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 44rem;
	}

	.tool-card {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 1.05rem;
		border: 1px solid var(--border);
		border-radius: 1.15rem;
		background: var(--card);
	}

	.tool-mark {
		width: 3rem;
		height: 3rem;
		flex: 0 0 3rem;
		display: grid;
		place-items: center;
		border-radius: 0.9rem;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--muted) 90%, var(--card) 10%) 0%,
			color-mix(in srgb, var(--border) 55%, var(--card) 45%) 100%
		);
		border: 1px solid color-mix(in srgb, var(--border) 88%, var(--background) 12%);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--foreground);
	}

	.tool-mark-dark {
		background: #111111;
		border-color: #111111;
	}

	.tool-logo {
		width: 1.55rem;
		height: 1.55rem;
		display: block;
		object-fit: contain;
	}

	.tool-name {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	@media (max-width: 980px) {
		.hero-subgrid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
